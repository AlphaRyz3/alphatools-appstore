{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "addLabels": ["renovate"],
  "enabledManagers": ["custom.regex"],
  "automerge": false,
  "automergeStrategy": "rebase",
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^.*docker-compose\\.ya?ml$/"],
      "matchStrings": ["image:\\s+[\"']?(?<depName>.*?):(?<currentValue>[^\"'\\s]+)[\"']?"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "matchPackageNames": ["ghcr.io/astraelabs/vibravid"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["ghcr.io/rmyndharis/openwa"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["mariadb", "mysql", "mongodb", "postgres", "redis"],
      "enabled": false
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bun ./scripts/update-config.ts {{packageFile}} {{newVersion}}",
      "bun install && bun run test"
    ],
    "fileFilters": ["**/*"],
    "executionMode": "update"
  }
}
